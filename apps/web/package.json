{
  "name": "@workbench/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "i18n:check": "bun scripts/check-i18n.ts",
    "deploy": "bun scripts/render-wrangler.ts && bun run build && wrangler deploy --config wrangler.deploy.jsonc"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@tanstack/react-query": "^5.10.0",
    "@ui-sdk/core": "^0.1.0-beta.17",
    "@ui-sdk/react": "^0.1.0-beta.17",
    "@workbench/shared": "workspace:*",
    "axios": "^1.13.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "ejs": ">=3.1.10",
    "follow-redirects": "^1.16.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^4.0.10",
    "lucide-react": "^0.363.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.55.0",
    "react-i18next": "^13.5.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.9.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.31",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-router-dom": "^6.19.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.2.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.162.0"
  }
